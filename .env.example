# ── Where transcripts go ───────────────────────────────────────────────────
# Local clone of the private data repo (fstuelzebach/financial_research_data).
# Leave empty to write into ./episodes of this repo (no publishing).
DATA_DIR=
DATA_BRANCH=main
# 1 = commit + push new transcripts and the heartbeat after every ingest
PUBLISH=0

# ── Host role ──────────────────────────────────────────────────────────────
# primary = always ingests (VPS). standby = only ingests when the primary has
# not published for STANDBY_AFTER_HOURS (Windows PC).
HOST_ROLE=primary
HOST_NAME=
STANDBY_AFTER_HOURS=24

# ── Transcription ──────────────────────────────────────────────────────────
WHISPER_ENGINE=auto        # auto | faster | openai
WHISPER_MODEL=small        # tiny | base | small | medium
KEEP_AUDIO=0
# Load warnings (ntfy) — the signal to move transcription to the Windows PC
MAX_RUNTIME_MIN=90
MAX_BACKLOG=6

# ── Notifications ──────────────────────────────────────────────────────────
NTFY_TOPIC=
LOG_FILE=logs/ingest.log

# ── Optional: local summaries (`python -m podcast_summarizer summarize`) ───
LLM_BACKEND=ollama         # ollama | claude
LLM_MODEL=
ANTHROPIC_API_KEY=
